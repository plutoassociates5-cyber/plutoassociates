# Copy to .env for local development ONLY (never commit real secrets).
#
# Local dev login (used by `npm run dev`; ignored in production builds).
# If these are unset, the dev server will use the /api/auth Function instead,
# which only runs under `wrangler pages dev` or on Cloudflare.
VITE_DEV_ADMIN_USER=
VITE_DEV_ADMIN_PASSWORD=

# Production credentials — set these in the Cloudflare Pages dashboard
# (Settings → Environment variables), NOT in this file:
#   ADMIN_USER      admin username
#   ADMIN_PASSWORD  admin password
#   ADMIN_SECRET    long random string used to sign session tokens
#   ADMIN_NAME      (optional) display name shown in the admin panel
