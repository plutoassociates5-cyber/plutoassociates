# Cloudflare Pages redirects — Pluto Associates SPA
# Each public route is prerendered to dist/<route>/index.html, so deep links
# resolve to real HTML without rewrites. Only dynamic/admin + legacy .html URLs need rules.

# Admin is prerendered to dist/admin/index.html like every public route, so
# /admin serves directly (Cloudflare auto-redirects /admin -> /admin/ -> 200).
# Only legacy .html URLs need explicit rules.
/about.html          /about          301
/practice-areas.html /practice-areas 301
/team.html           /teams          301
/publications.html   /publications   301
/contact.html        /contact        301
